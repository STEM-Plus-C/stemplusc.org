---
import { SITE } from '../consts';
const currentYear = new Date().getFullYear();
---

<footer class="bg-navy text-white">
  <div class="max-w-6xl mx-auto px-4 py-12">
    <div class="grid md:grid-cols-4 gap-8">
      <!-- Logo & About -->
      <div class="md:col-span-2">
        <img src="/logo.svg" alt="STEM+C" class="h-16 w-auto mb-4 brightness-0 invert" />
        <p class="text-gray-300 text-sm max-w-md">
          {SITE.orgOneLiner}
        </p>
        <p class="text-gray-400 text-sm mt-2">EIN: 83-3523903</p>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="font-semibold mb-4 text-white">Quick Links</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/about" class="text-gray-300 hover:text-white transition-colors">About Us</a></li>
          <li><a href="/programs" class="text-gray-300 hover:text-white transition-colors">Programs</a></li>
          <li><a href="/donate" class="text-gray-300 hover:text-white transition-colors">Donate</a></li>
          <li><a href="/impact" class="text-gray-300 hover:text-white transition-colors">Impact &amp; Transparency</a></li>
          <li><a href="/contact" class="text-gray-300 hover:text-white transition-colors">Contact</a></li>
          <li><a href="/policies" class="text-gray-300 hover:text-white transition-colors">Policies &amp; Forms</a></li>
        </ul>
        <h3 class="font-semibold mb-3 mt-6 text-white">Our Teams</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="https://tiedyesamurai.org" target="_blank" rel="noopener" class="text-gray-300 hover:text-white transition-colors">Tie Dye Samurai (FRC)</a></li>
          <li><a href="https://tiedyejedi.org" target="_blank" rel="noopener" class="text-gray-300 hover:text-white transition-colors">Tie Dye Jedi (FTC)</a></li>
        </ul>
      </div>

      <!-- Connect -->
      <div>
        <h3 class="font-semibold mb-4 text-white">Connect</h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="mailto:info@stemplusc.org" class="text-gray-300 hover:text-white transition-colors">
              info@stemplusc.org
            </a>
          </li>
          {SITE.socials.map((social) => (
            <li>
              <a href={social.url} target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-gray-300 hover:text-white transition-colors">
                <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d={social.icon} />
                </svg>
                {social.name}
              </a>
            </li>
          ))}
        </ul>
        <p class="text-gray-400 text-sm mt-4">Gilbert, Arizona</p>
      </div>
    </div>

    <div class="border-t border-gray-700 mt-8 pt-8 text-center text-sm text-gray-400">
      <p>&copy; {currentYear} STEM+C. All rights reserved.</p>
    </div>
  </div>
</footer>
