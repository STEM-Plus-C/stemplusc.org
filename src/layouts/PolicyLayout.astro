---
/**
 * Shared chrome for the policy documents under /policies.
 *
 * These pages are meant to be *read as documents* — long-form, printable, and
 * stable enough to cite by section. The layout supplies the title block,
 * effective date, print button, and the prose styling every document shares so
 * the documents themselves stay pure content.
 *
 * Prose styling is written out longhand rather than pulled from a typography
 * plugin: this project has no `@tailwindcss/typography`, and the CSS-first v4
 * setup keeps custom element styles in `@layer base` (see global.css).
 */
import BaseLayout from './BaseLayout.astro';

interface Props {
  /** Document title, e.g. "Student & Family Team Agreement". */
  title: string;
  /** Meta description for the page. */
  description: string;
  /**
   * The date this document took effect, e.g. "August 14, 2026". A specific date
   * rather than a season: a family needs to know which version of the terms
   * they agreed to, and "the 2026–2027 season" cannot distinguish two revisions
   * within the same season.
   */
  effective: string;
  /**
   * The date of the most recent substantive change, if the document has been
   * revised since it took effect. Changed terms bind from their own date, not
   * retroactively — anyone who signed the earlier version signed the earlier
   * terms, so both dates have to be visible.
   */
  revised?: string;
  /** Optional banner rendered above the document body. */
  notice?: string;
  /**
   * Path to the PDF rendered from this page by `npm run policies:pdf`. Offered
   * as a download so a family can keep the same document they sign.
   */
  pdf?: string;
  /** Heading for the notice banner. */
  noticeTitle?: string;
  /**
   * Banner styling. `warning` (amber) for a document that must not be relied
   * on yet; `info` (blue) for standing context on a document in force.
   */
  noticeTone?: 'warning' | 'info';
}

const {
  title,
  description,
  effective,
  revised,
  notice,
  noticeTitle,
  noticeTone = 'warning',
  pdf,
} = Astro.props;

const noticeStyles = {
  warning: {
    section: 'bg-amber-50 border-y-2 border-amber-400',
    text: 'text-amber-900',
  },
  info: {
    section: 'bg-blue-50 border-y-2 border-brand-blue',
    text: 'text-navy',
  },
}[noticeTone];
---

<BaseLayout title={title} description={description} noindex={true}>
  <!-- Title block -->
  <section class="bg-navy text-white py-12 md:py-16 print:bg-white print:text-navy print:py-4">
    <div class="max-w-3xl mx-auto px-4">
      <a
        href="/policies"
        class="text-sm text-brand-blue hover:underline print:hidden"
      >&larr; All policies &amp; forms</a>
      <!--
        Print-only masthead. On screen the site header already carries the
        logo; in print that header is stripped, and these documents get saved
        as PDF and circulated for signature — so they have to identify
        themselves without the surrounding site.
      -->
      <img
        src="/logo.svg"
        alt="STEM+C"
        class="hidden print:block h-20 w-auto mb-5"
      />
      <h1 class="text-3xl md:text-4xl font-bold mt-3 mb-3 text-white print:text-navy">{title}</h1>
      <p class="text-gray-300 print:text-gray-700">
        A program policy of <strong class="text-white print:text-navy">STEM+C</strong>, a 501(c)(3) nonprofit &middot; EIN 83-3523903
      </p>
      <p class="text-gray-400 text-sm mt-1 print:text-gray-600">
        Effective {effective}{revised && <> &middot; Revised {revised}</>}
      </p>
    </div>
  </section>

  {notice && (
    <section class={noticeStyles.section}>
      <div class="max-w-3xl mx-auto px-4 py-5">
        <p class={`${noticeStyles.text} text-sm leading-relaxed`}>
          {noticeTitle && <strong class="block mb-1">{noticeTitle}</strong>}
          {notice}
        </p>
      </div>
    </section>
  )}

  <!-- Document body -->
  <section class="py-12 md:py-16">
    <div
      class="max-w-3xl mx-auto px-4 policy-doc"
    >
      <slot />

      <div class="mt-12 pt-8 border-t border-gray-200 print:hidden">
        <div class="flex flex-wrap gap-3">
          <button
            type="button"
            data-print
            class="bg-navy text-white px-6 py-3 rounded-lg font-semibold hover:bg-blue-900 transition-colors"
          >
            Print this document
          </button>
          {pdf && (
            <a
              href={pdf}
              download
              class="inline-flex items-center gap-2 border-2 border-navy text-navy px-6 py-3 rounded-lg font-semibold hover:bg-navy hover:text-white transition-colors"
            >
              Download PDF
            </a>
          )}
        </div>
        <p class="text-sm text-gray-500 mt-4">
          Questions about anything here? Email
          <a href="mailto:info@stemplusc.org" class="text-brand-blue hover:underline">info@stemplusc.org</a>
          — we would always rather answer a question than have a family guess.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  document
    .querySelector<HTMLButtonElement>('[data-print]')
    ?.addEventListener('click', () => window.print());
</script>

<style>
  /* Document typography. Scoped to .policy-doc so it never leaks into the
     marketing pages, and expressed as element selectors so the document
     content stays plain semantic HTML. */
  .policy-doc :global(h2) {
    font-size: 1.5rem;
    line-height: 2rem;
    font-weight: 700;
    color: var(--color-navy);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  .policy-doc :global(h2:first-child) {
    margin-top: 0;
  }

  .policy-doc :global(h3) {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-navy);
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
  }

  .policy-doc :global(p) {
    margin-bottom: 1rem;
    line-height: 1.75;
    color: #374151;
  }

  .policy-doc :global(ul),
  .policy-doc :global(ol) {
    margin-bottom: 1rem;
    padding-left: 1.5rem;
    line-height: 1.75;
    color: #374151;
  }

  .policy-doc :global(ul) {
    list-style-type: disc;
  }

  .policy-doc :global(ol) {
    list-style-type: decimal;
  }

  .policy-doc :global(li) {
    margin-bottom: 0.5rem;
  }

  .policy-doc :global(a) {
    color: var(--color-brand-blue);
    text-decoration: underline;
  }

  @media print {
    .policy-doc :global(h2) {
      break-after: avoid;
    }
  }
</style>
